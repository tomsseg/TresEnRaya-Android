<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/Title"
        android:layout_width="352dp"
        android:layout_height="129dp"
        android:fontFamily="casual"
        android:rotation="0"
        android:rotationX="0"
        android:text="Tres en Raya 2"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.048" />

    <FrameLayout
        android:id="@+id/contenedorTablero"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Imagen del tablero -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/tablero"
            android:scaleType="fitXY"
            android:contentDescription="Tablero" />

        <!-- Casillas encima del tablero -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="3"
            android:rowCount="3">

            <ImageButton
                android:id="@+id/casilla0"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla1"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla2"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla3"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla4"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla5"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla6"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla7"
                style="@style/CasillaTresEnRaya" />

            <ImageButton
                android:id="@+id/casilla8"
                style="@style/CasillaTresEnRaya" />

        </GridLayout>

    </FrameLayout>


</androidx.constraintlayout.widget.ConstraintLayout>